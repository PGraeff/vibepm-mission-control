{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibepm.local/schemas.json",
  "title": "VibePM Mission Control Data Model",
  "type": "object",
  "required": ["version", "backend", "cards", "projects", "activity"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 3
    },
    "backend": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "syncStatus": { "type": "string" },
        "lastScannedAt": { "type": "string" },
        "lastExportedAt": { "type": "string" }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "id",
        "column",
        "order",
        "title",
        "outcome",
        "owner",
        "status",
        "impact",
        "confidence",
        "risk",
        "context",
        "gate",
        "prd",
        "prdFields",
        "prompt",
        "agentSpec",
        "signals",
        "agentRuns",
        "decisions",
        "checks",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string" },
        "generated": { "type": "boolean" },
        "column": {
          "type": "string",
          "enum": ["Idea Intake", "Shape", "Build Watch", "Launch Ready"]
        },
        "order": { "type": "number" },
        "title": { "type": "string" },
        "outcome": { "type": "string" },
        "owner": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Signal", "Draft", "Spec", "Active", "Review", "Guard", "Ship", "Blocked"]
        },
        "impact": { "type": "integer", "minimum": 1, "maximum": 10 },
        "confidence": { "type": "integer", "minimum": 1, "maximum": 10 },
        "risk": { "type": "integer", "minimum": 1, "maximum": 10 },
        "context": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gate": { "type": "string" },
        "prd": { "type": "string" },
        "prdFields": { "type": "object" },
        "prompt": { "type": "string" },
        "agentSpec": { "type": "object" },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agentRuns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "decisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/launchCheck"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "launchCheck": {
      "type": "object",
      "required": ["id", "label", "done"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "done": { "type": "boolean" }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "path", "status", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "productGoal": { "type": "string" },
        "currentFocus": { "type": "string" },
        "hasPlaybook": { "type": "boolean" },
        "status": { "type": "string" },
        "dirtyFiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "latestCommit": { "type": "string" },
        "linkedCards": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "projectId", "source", "status", "title", "detail", "linkedCardId", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "source": { "type": "string" },
        "status": { "type": "string" },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "linkedCardId": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
